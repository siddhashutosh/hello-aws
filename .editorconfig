root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 reads .ps1 as ANSI unless the file carries a BOM, so
# scripts here stay ASCII-only. CRLF keeps native tooling happy.
[*.ps1]
end_of_line = crlf
